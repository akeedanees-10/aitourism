# AI-Based Personalized Tourism Recommendation System
# Configuration & API Keys

# Local SQLite Database
DATABASE_URL=sqlite:///./tourism.db

# Security
SECRET_KEY=tourist-super-secret-jwt-key-2026-development
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Model Provider: Add your API key below to enable live AI responses!
# Option 1: OpenAI (ChatGPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option 2: Groq (Ultra-fast & free at console.groq.com)
GROQ_API_KEY=

# Option 3: Google Gemini (Free at aistudio.google.com)
GEMINI_API_KEY=

# Optional Weather API
OPENWEATHER_API_KEY=
